	box = 50.285714285714285,
	radius = 2.2857142857142856,
	layers = { { kind = "conv", nout = 48, nper = 36, cin = 4, pool = true, scaleInputs = true }, { kind = "conv", nout = 96, nper = 432, cin = 48, pool = true, scaleInputs = false }, { kind = "conv", nout = 192, nper = 864, cin = 96, pool = true, scaleInputs = false }, { kind = "dense", nout = 768, nper = 12288, normalizeInput = false }, { kind = "dense", nout = 299, nper = 768, normalizeInput = false } },
	data = table.concat({
		require(script:WaitForChild("WeightPart001")),
		require(script:WaitForChild("WeightPart002")),
		require(script:WaitForChild("WeightPart003")),
