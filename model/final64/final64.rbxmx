	labels = { "anvil", "piano", "hammer", "axe", "sword", "knife", "saw", "baseball bat", "frying pan", "boomerang", "rifle", "cannon", "tornado", "hurricane", "lightning", "rain", "campfire", "shark", "crocodile", "dragon", "snake", "spider", "scorpion", "bee", "lion", "bulldozer", "helicopter", "airplane", "submarine", "police car", "firetruck", "flying saucer", "shovel", "drill", "scissors", "fork", "rake", "screwdriver", "pliers", "golf club", "hockey stick", "dumbbell", "bear", "tiger", "rhinoceros", "elephant", "octopus", "whale", "bat", "ant", "mosquito", "crab", "lobster", "hedgehog", "tractor", "train", "truck", "aircraft carrier", "speedboat", "cactus", "tree", "mountain", "snowflake", "sun", "cloud", "moon", "star", "rainbow", "ocean", "snowman", "ice cream", "fire hydrant", "bucket", "umbrella", "fan", "hourglass", "alarm clock", "light bulb", "stop sign", "jail", "hot air balloon", "megaphone", "drums", "bandage", "foot", "hand", "skull", "car", "house", "castle", "The Eiffel Tower", "toilet", "banana", "pizza", "mushroom", "cow", "pig", "frog", "penguin", "soccer ball", "candle", "fireplace", "lantern", "matches", "lighter", "river", "flower", "palm tree", "leaf", "bush", "bathtub", "bed", "couch", "chair", "table", "bench", "dresser", "washing machine", "microwave", "oven", "stove", "television", "computer", "laptop", "toaster", "wheel", "ladder", "door", "fence", "mailbox", "streetlight", "traffic light", "cooler", "baseball", "basketball", "tennis racquet", "hockey puck", "broom", "nail", "syringe", "key", "helmet", "crown", "diamond", "dog", "cat", "horse", "bird", "owl", "duck", "parrot", "flamingo", "swan", "fish", "dolphin", "sea turtle", "snail", "butterfly", "giraffe", "zebra", "camel", "kangaroo", "monkey", "panda", "rabbit", "raccoon", "sheep", "squirrel", "mouse", "teddy-bear", "mermaid", "angel", "bus", "school bus", "ambulance", "van", "pickup truck", "motorbike", "bicycle", "skateboard", "sailboat", "canoe", "cruise ship", "parachute", "ro